{
    "name": "Drums_9th_44k",
    "n_gpu": 1,
    "arch": {
        "type": "RawAudioVAE",
        "args": {
            "latent_dim": 32,
            "channels": [
                32,
                64,
                128,
                256,
                512,
                512
            ],
            "strides": [
                4,
                4,
                4,
                4,
                2
            ]
        }
    },
    "data_loader": {
        "type": "OneShotAudioDataLoader",
        "args": {
            "data_dir": [
                "/scratch/users/nlabate/datasets/drums_oneshots"
            ],
            "sr": 44100,
            "chunk_size": 65536,
            "onset_thresh": 0.02,
            "pre_pad": 512,
            "peak_norm": true,
            "fixed_split": true,
            "types": [
                "kick",
                "snare",
                "clap",
                "hat",
                "cymbal",
                "tom",
                "perc"
            ],
            "packs": [
                "9th_wonder_drum_kit"
            ],
            "batch_size": 8,
            "shuffle": true,
            "validation_split": 0.0,
            "num_workers": 4
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.0003,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "raw_audio_vae_loss",
    "metrics": [],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 1200,
            "gamma": 0.5
        }
    },
    "trainer": {
        "type": "RawAudioVaeAdversarialTrainer",
        "epochs": 6000,
        "save_dir": "saved/",
        "save_period": 40,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 6000,
        "tensorboardX": true,
        "beta_max": 0.02,
        "beta_warmup": 800,
        "free_bits": 0.15,
        "adv_start_epoch": 2000,
        "lambda_adv": 1.0,
        "lambda_fm": 10.0,
        "discriminator": "waveform",
        "disc_capacity": 8,
        "disc_lr": 0.0001,
        "disc_update_every": 2,
        "freeze_encoder": false,
        "grad_clip": 5.0
    }
}
