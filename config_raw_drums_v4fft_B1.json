{
    "name": "Drums_v4fft_B1",
    "n_gpu": 1,
    "arch": {
        "type": "RawAudioVAE",
        "args": {
            "latent_dim": 32,
            "channels": [
                32,
                64,
                128,
                256,
                512,
                512
            ],
            "strides": [
                4,
                4,
                4,
                4,
                2
            ],
            "amp_out": true
        }
    },
    "data_loader": {
        "type": "OneShotAudioDataLoader",
        "args": {
            "data_dir": [
                "/scratch/users/nlabate/datasets/drums_oneshots"
            ],
            "sr": 44100,
            "chunk_size": 65536,
            "onset_thresh": 0.02,
            "pre_pad": 512,
            "peak_norm": true,
            "fixed_split": true,
            "types": [
                "kick",
                "snare",
                "clap",
                "hat",
                "cymbal",
                "tom",
                "perc"
            ],
            "batch_size": 8,
            "shuffle": true,
            "validation_split": 0.0,
            "num_workers": 4,
            "exclude": "splits/exclude_train.txt",
            "augment": {
                "p_pitch": 0.5,
                "semitones": 2.0,
                "p_decay": 0.25,
                "decay_start": [
                    0.05,
                    0.4
                ],
                "decay_tau": [
                    0.02,
                    0.15
                ]
            },
            "type_weights": {
                "cymbal": 2.0,
                "tom": 2.0,
                "clap": 1.5
            }
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.0003,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "raw_audio_vae_loss",
    "metrics": [],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 137,
            "gamma": 0.5
        }
    },
    "trainer": {
        "type": "RawAudioVaeAdversarialTrainer",
        "epochs": 455,
        "save_dir": "saved/",
        "save_period": 23,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 455,
        "tensorboardX": true,
        "beta_max": 0.005,
        "beta_warmup": 91,
        "free_bits": 0.15,
        "adv_start_epoch": 228,
        "lambda_adv": 1.0,
        "lambda_fm": 10.0,
        "discriminator": "waveform",
        "disc_capacity": 8,
        "disc_lr": 0.0001,
        "disc_update_every": 2,
        "freeze_encoder": true,
        "grad_clip": 5.0
    },
    "seed": 1,
    "loss_args": {
        "fft_sizes": [
            8192,
            4096,
            2048,
            1024,
            512,
            256
        ],
        "hop_sizes": [
            2048,
            1024,
            512,
            256,
            128,
            64
        ]
    }
}